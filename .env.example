# Скопируйте в .env и при необходимости измените. Без .env используются значения по умолчанию.

# PostgreSQL
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
# Порт БД на хосте (поменяйте, если 5432 занят)
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
ENVIRONMENT=docker
JWT_SECRET=dev-secret-change-me
# JSON-список адресов фронтенда
CORS_ORIGINS=["http://localhost:3000"]
# Демо-учётки, компании и продукты при старте (идемпотентно)
SEED_DEMO_DATA=true
# Датасет профилей заёмщиков: положите файл в ./data и укажите путь внутри контейнера,
# например /data/borrowers.jsonl. Пусто - моки генерируют данные сами
BORROWER_DATASET_PATH=
# Модель скоринга: ml - сервис ml (при недоступности - правила), rules - только правила
SCORING_MODEL=ml
# Модель и калибровка в сервисе ml. В образе обучается catboost (ml/Dockerfile);
# калибровка: platt | isotonic | raw
ML_MODEL_NAME=catboost
ML_CALIBRATION=platt

# Frontend
FRONTEND_PORT=3000
